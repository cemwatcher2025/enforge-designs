{
  "id": "roam-interaction-library",
  "name": "ROAM Interaction Library",
  "version": "1.0.0",
  "source": {
    "file": "ROAM_Interaction_Library.pdf",
    "notes": "Converted into a portable interaction grammar for Enforge Command Center, ROAM, Unreal Engine, and future projects."
  },
  "designIntent": {
    "summary": "Reusable interaction mechanics for exploration, discovery, repair, restoration, world traversal, tools, and social play.",
    "principles": [
      "Interactions should reveal the world instead of merely consuming clicks.",
      "Feedback should be visible, audible, logged, or reflected in the environment.",
      "Most useful interactions can chain into a next verb, clue, state, or unlocked space.",
      "Not every object needs interaction; static decor gives interactive objects context and value.",
      "Objects should support richer interaction arrays over time, even if v1 uses a single primary interactionType."
    ]
  },
  "categories": [
    {
      "id": "discovery",
      "name": "Discovery Interactions",
      "description": "Perception and knowledge-gathering verbs that teach the player what a thing is, where it belongs, and what it may unlock."
    },
    {
      "id": "repair_restoration",
      "name": "Repair and Restoration",
      "description": "Mechanical, environmental, or civic restoration verbs that turn broken spaces into usable places."
    },
    {
      "id": "environment",
      "name": "Environmental Interactions",
      "description": "Direct manipulation of doors, light, water, mechanisms, power, and navigation features."
    },
    {
      "id": "tool_based",
      "name": "Tool-Based Interactions",
      "description": "Inventory, crafting, placement, extraction, and construction verbs that let the player change the world with tools."
    },
    {
      "id": "social",
      "name": "Social and NPC Interactions",
      "description": "Conversation, teaching, trade, assistance, and shared-knowledge verbs for people, groups, and communities."
    }
  ],
